{
  "name": "dsh-xmind-mcp",
  "version": "3.0.0",
  "type": "module",
  "description": "Xmind cloud mind-map plugin for DeepSeek Harness: 35 xmind_* tools to list, read, create and rewrite the user's Xmind maps from natural language. Runs fully in-process (no child process), so it works on HarmonyOS/DSHM where fork/exec is forbidden. OAuth 2.1 with automatic token refresh, zero dependencies.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "xmind",
    "mindmap",
    "mcp",
    "harmonyos",
    "ondevice"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macroboring/dsh-xmind-mcp.git"
  },
  "homepage": "https://github.com/macroboring/dsh-xmind-mcp#readme",
  "bugs": {
    "url": "https://github.com/macroboring/dsh-xmind-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "icon": "./icon.svg",
  "main": "./host/index.mjs",
  "exports": {
    ".": "./host/index.mjs",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "host",
    "lib",
    "locale",
    "test",
    "cli.mjs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "HANDOFF.md",
    "PUBLISHING.md",
    "PROVENANCE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/refresh.test.mjs && node test/host-plugin.test.mjs && node test/install.test.mjs && node test/no-machine-paths.mjs",
    "doctor": "node cli.mjs doctor"
  },
  "bin": {
    "dsh-xmind-mcp": "./cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
